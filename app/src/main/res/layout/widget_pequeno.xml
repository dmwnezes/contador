<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRaiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_vidro" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/wPonto" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_ponto" />
        <TextView android:id="@+id/wNome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:ellipsize="end" android:maxLines="1" android:text="GTA 6" android:textColor="#B3FFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/wNumero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false"
            android:maxLines="1" android:text="22" android:textColor="#FFFFFFFF" android:textSize="46sp" android:textStyle="bold" android:letterSpacing="-0.04" />
        <TextView android:id="@+id/wRotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="6dp"
            android:text="dias" android:textColor="#A6FFFFFF" android:textSize="13sp" />
    </LinearLayout>
    <Chronometer android:id="@+id/wRelogio" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFF5D8F" android:textSize="18sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/wBarra" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp"
        android:layout_marginTop="8dp" android:max="100" android:progress="46" android:progressDrawable="@drawable/widget_barra" />
</LinearLayout>

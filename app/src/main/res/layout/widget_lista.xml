<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRaiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_vidro" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRÓXIMOS"
        android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/wVazio" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="Nenhum evento futuro" android:textColor="#A6FFFFFF" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/wL1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wN1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="GTA 6" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wD1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="23" android:textColor="#FFFF5D8F" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" />
    <LinearLayout android:id="@+id/wL2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wN2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="Viagem de férias" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wD2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="54" android:textColor="#FFFF5D8F" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" />
    <LinearLayout android:id="@+id/wL3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wN3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="Aniversário" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wD3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="99" android:textColor="#FFFF5D8F" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

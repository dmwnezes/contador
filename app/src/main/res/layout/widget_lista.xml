<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRaiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_vidro" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRÓXIMOS"
        android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/wVazio" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="Nenhum evento futuro" android:textColor="#A6FFFFFF" android:textSize="12sp" android:visibility="gone" />
    <ViewFlipper android:id="@+id/wGiro" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:autoStart="true" android:flipInterval="3500" android:inAnimation="@anim/giro_entra" android:outAnimation="@anim/giro_sai">
        <include layout="@layout/widget_giro_item" />
    </ViewFlipper>
</LinearLayout>
